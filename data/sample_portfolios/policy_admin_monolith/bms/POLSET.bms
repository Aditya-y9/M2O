POLSET   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,     *
               CTRL=(FREEKB,FRSET),TERM=3270-2,TIOAPFX=YES
POLM01   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
PTITLE   DFHMDF POS=(1,25),LENGTH=30,ATTRB=(ASKIP,BRT),               *
               INITIAL='POLICY ADMINISTRATION SYSTEM'
POLIN    DFHMDF POS=(4,15),LENGTH=10,ATTRB=(UNPROT,IC,FSET)
HOLDER   DFHMDF POS=(6,15),LENGTH=40,ATTRB=(ASKIP,NORM)
PREM     DFHMDF POS=(8,15),LENGTH=12,ATTRB=(ASKIP,BRT)
POLSET   DFHMSD TYPE=FINAL
         END
