IDENTIFICATION DIVISION.
PROGRAM-ID. POLC200.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT VSAM-POLICY ASSIGN TO POLKSDS
        ORGANIZATION IS INDEXED
        ACCESS MODE IS RANDOM
        RECORD KEY IS POL-ID.
DATA DIVISION.
FILE SECTION.
FD  VSAM-POLICY.
COPY POLREC.
WORKING-STORAGE SECTION.
COPY CLMREC.
01 WS-ACTION-CODE             PIC 9(1).
01 WS-RESP                    PIC S9(8) COMP.

PROCEDURE DIVISION.
0000-PROCESS-CLAIM.
    EXEC CICS READ DATASET('POLKSDS')
              INTO(POLICY-RECORD)
              RIDFLD(CLAIM-POLICY-ID)
              RESP(WS-RESP)
    END-EXEC.

    IF WS-RESP NOT = DFHRESP(NORMAL)
        MOVE 9 TO WS-ACTION-CODE
    ELSE
        MOVE 1 TO WS-ACTION-CODE
    END-IF.

    * Legacy dispatch pattern
    GO TO 1000-APPROVE-CLAIM
          2000-PENDING-REVIEW
          3000-REJECT-CLAIM
          9000-ERROR-EXIT
        DEPENDING ON WS-ACTION-CODE.

1000-APPROVE-CLAIM.
    EXEC CICS WRITE DATASET('CLMKSDS')
              FROM(CLAIM-RECORD)
              RIDFLD(CLAIM-ID)
              RESP(WS-RESP)
    END-EXEC.
    PERFORM 9999-FINISH.

2000-PENDING-REVIEW.
    PERFORM 9999-FINISH.

3000-REJECT-CLAIM.
    PERFORM 9999-FINISH.

9000-ERROR-EXIT.
    PERFORM 9999-FINISH.

9999-FINISH.
    EXEC CICS RETURN END-EXEC.
