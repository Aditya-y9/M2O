IDENTIFICATION DIVISION.
PROGRAM-ID. POLC100.
ENVIRONMENT DIVISION.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY POLREC.
01 WS-COMM-AREA.
   05 CA-STATE                PIC X(10).
   05 CA-POLICY-ID            PIC 9(10).
   05 CA-SESSION-STEP         PIC 9(2).
01 WS-RESP                    PIC S9(8) COMP.
01 SWITCH-A                   PIC X(1) VALUE 'N'.

PROCEDURE DIVISION.
0000-START-CONVERSATION.
    EXEC CICS RECEIVE INTO(WS-COMM-AREA)
              LENGTH(LENGTH OF WS-COMM-AREA)
              RESP(WS-RESP)
    END-EXEC.

    IF CA-SESSION-STEP = 1
        PERFORM 1000-STEP-ONE
    ELSE
        PERFORM 2000-STEP-TWO
    END-IF.

    * Legacy dynamic ALTER verb usage
    ALTER 9000-ROUTING TO PROCEED TO 9100-POLICY-FOUND.

    * Conversational hold - state held across user interaction
    EXEC CICS CONVERSE
         FROM(WS-COMM-AREA)
         FROMLENGTH(LENGTH OF WS-COMM-AREA)
         INTO(WS-COMM-AREA)
         TOLENGTH(LENGTH OF WS-COMM-AREA)
    END-EXEC.

    PERFORM 9000-ROUTING.

1000-STEP-ONE.
    MOVE 2 TO CA-SESSION-STEP.
    MOVE 'ACTIVE-STEP-1' TO CA-STATE.

2000-STEP-TWO.
    MOVE 3 TO CA-SESSION-STEP.

9000-ROUTING.
    GO TO 9200-POLICY-DEFAULT.

9100-POLICY-FOUND.
    EXEC CICS RETURN END-EXEC.

9200-POLICY-DEFAULT.
    EXEC CICS RETURN END-EXEC.
