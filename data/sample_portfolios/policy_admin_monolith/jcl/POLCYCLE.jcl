//POLCYCLE JOB (INS,9901),'INSURANCE POLICY CYCLE',CLASS=C,MSGCLASS=H
//*
//STEP010  EXEC PGM=POLBAT01
//STEPLIB  DD DSN=INS.PROD.LOADLIB,DISP=SHR
//POLIN    DD DSN=INS.POLICY.MASTER.KSDS,DISP=SHR
//POLOUT   DD DSN=INS.RATED.EXTRACT(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(50,10),RLSE),
//            DCB=(RECFM=FB,LRECL=200,BLKSIZE=20000)
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC PGM=POLREP01,COND=(4,LT,STEP010)
//STEPLIB  DD DSN=INS.PROD.LOADLIB,DISP=SHR
//REPIN    DD DSN=INS.RATED.EXTRACT(+1),DISP=SHR
//REPOUT   DD SYSOUT=*
//*
