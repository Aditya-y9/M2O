ACCTSET  DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,STORAGE=AUTO,     *
               CTRL=(FREEKB,FRSET),TERM=3270-2,TIOAPFX=YES
ACCTM01  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
TITLE    DFHMDF POS=(1,28),LENGTH=24,ATTRB=(ASKIP,BRT),               *
               INITIAL='CORE BANKING DEPOSIT INQUIRY'
ACCIN    DFHMDF POS=(5,15),LENGTH=10,ATTRB=(UNPROT,IC,FSET)
BALOUT   DFHMDF POS=(8,15),LENGTH=15,ATTRB=(ASKIP,BRT)
STATUS   DFHMDF POS=(10,15),LENGTH=40,ATTRB=(ASKIP,NORM)
ERROUT   DFHMDF POS=(23,10),LENGTH=60,ATTRB=(ASKIP,BRT,COLOR=RED)
ACCTM02  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
T2TITLE  DFHMDF POS=(1,28),LENGTH=24,ATTRB=(ASKIP,BRT),               *
               INITIAL='CUSTOMER DEPOSIT TRANSACTION'
DEPAMT   DFHMDF POS=(6,20),LENGTH=12,ATTRB=(UNPROT,NUM,IC,FSET)
ACCTSET  DFHMSD TYPE=FINAL
         END
