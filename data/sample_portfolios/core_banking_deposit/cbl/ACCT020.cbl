IDENTIFICATION DIVISION.
PROGRAM-ID. ACCT020.
ENVIRONMENT DIVISION.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY ACCTREC.
COPY TXNREC.
01 WS-RESP                   PIC S9(8) COMP.
01 WS-NEW-BAL                PIC S9(9)V99 COMP-3.

EXEC SQL INCLUDE SQLCA END-EXEC.

PROCEDURE DIVISION.
0000-PROCESS-DEPOSIT.
    EXEC CICS RECEIVE MAP('ACCTM02') MAPSET('ACCTSET')
              RESP(WS-RESP)
    END-EXEC.

    IF WS-RESP = DFHRESP(NORMAL)
        PERFORM 1000-VALIDATE-AMOUNT
        PERFORM 2000-UPDATE-LEDGER
        PERFORM 3000-WRITE-AUDIT-LOG
        PERFORM 4000-SEND-SUCCESS
    ELSE
        PERFORM 9999-REJECT-TXN
    END-IF.

    EXEC CICS RETURN TRANSID('ACT2') END-EXEC.

1000-VALIDATE-AMOUNT.
    IF TXN-AMOUNT <= 0
        MOVE 'Invalid deposit amount' TO WS-ERROR-MSG
    END-IF.

2000-UPDATE-LEDGER.
    EXEC SQL
        UPDATE ACCOUNT_MASTER
        SET BALANCE = BALANCE + :TXN-AMOUNT,
            LAST_UPDATED = CURRENT TIMESTAMP
        WHERE ACCOUNT_ID = :WS-ACCOUNT-NUMBER
    END-EXEC.

3000-WRITE-AUDIT-LOG.
    EXEC SQL
        INSERT INTO TRANSACTION_LOG
        (TXN_ID, ACCOUNT_ID, AMOUNT, TXN_TYPE, CREATED_AT)
        VALUES (:TXN-ID, :WS-ACCOUNT-NUMBER, :TXN-AMOUNT, 'DEP', CURRENT TIMESTAMP)
    END-EXEC.

4000-SEND-SUCCESS.
    MOVE 'Deposit Processed Successfully' TO MAP-MSG-OUT.
    EXEC CICS SEND MAP('ACCTM02') MAPSET('ACCTSET') ERASE END-EXEC.

9999-REJECT-TXN.
    MOVE 'Deposit Failed' TO MAP-ERR-OUT.
    EXEC CICS SEND MAP('ACCTM02') MAPSET('ACCTSET') END-EXEC.
