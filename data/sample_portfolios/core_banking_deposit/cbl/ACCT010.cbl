IDENTIFICATION DIVISION.
PROGRAM-ID. ACCT010.
ENVIRONMENT DIVISION.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY ACCTREC.
01 WS-RESPONSE-CODE           PIC S9(8) COMP.
01 WS-BALANCE                 PIC S9(9)V99 COMP-3.
01 WS-ACCOUNT-STATUS          PIC X(1).
   88 STATUS-ACTIVE           VALUE 'A'.
   88 STATUS-DORMANT          VALUE 'D'.
   88 STATUS-FROZEN           VALUE 'F'.

EXEC SQL INCLUDE SQLCA END-EXEC.

PROCEDURE DIVISION.
0000-MAIN-PROCESS.
    EXEC CICS RECEIVE MAP('ACCTM01') MAPSET('ACCTSET')
              RESP(WS-RESPONSE-CODE)
    END-EXEC.

    IF WS-RESPONSE-CODE = DFHRESP(NORMAL)
        PERFORM 1000-QUERY-ACCOUNT
        PERFORM 2000-SEND-RESPONSE
    ELSE
        PERFORM 9000-HANDLE-ERROR
    END-IF.

    EXEC CICS RETURN TRANSID('ACT1') END-EXEC.

1000-QUERY-ACCOUNT.
    EXEC SQL
        SELECT BALANCE, STATUS
        INTO :WS-BALANCE, :WS-ACCOUNT-STATUS
        FROM ACCOUNT_MASTER
        WHERE ACCOUNT_ID = :WS-ACCOUNT-NUMBER
    END-EXEC.

    IF SQLCODE NOT = 0
        MOVE 'Account Not Found' TO WS-STATUS-MSG
    END-IF.

2000-SEND-RESPONSE.
    MOVE WS-BALANCE TO MAP-BAL-OUT.
    EXEC CICS SEND MAP('ACCTM01') MAPSET('ACCTSET') ERASE END-EXEC.

9000-HANDLE-ERROR.
    MOVE 'System Error Encountered' TO MAP-ERR-OUT.
    EXEC CICS SEND MAP('ACCTM01') MAPSET('ACCTSET') END-EXEC.
