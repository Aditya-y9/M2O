IDENTIFICATION DIVISION.
PROGRAM-ID. ACCTPOST.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TXN-FILE ASSIGN TO TXNIN
        ORGANIZATION IS SEQUENTIAL.
    SELECT REPORT-FILE ASSIGN TO PRTFILE
        ORGANIZATION IS SEQUENTIAL.
DATA DIVISION.
FILE SECTION.
FD  TXN-FILE.
COPY TXNREC.
FD  REPORT-FILE.
01  RPT-RECORD               PIC X(132).

WORKING-STORAGE SECTION.
01 WS-EOF                    PIC X(1) VALUE 'N'.
01 WS-RECORD-COUNT           PIC 9(9) VALUE 0.
01 WS-TOTAL-POSTED           PIC S9(11)V99 COMP-3 VALUE 0.

EXEC SQL INCLUDE SQLCA END-EXEC.

PROCEDURE DIVISION.
0000-MAIN-POSTING.
    OPEN INPUT TXN-FILE
         OUTPUT REPORT-FILE.

    PERFORM UNTIL WS-EOF = 'Y'
        READ TXN-FILE
            AT END
                MOVE 'Y' TO WS-EOF
            NOT AT END
                PERFORM 1000-PROCESS-BATCH-TXN
        END-READ
    END-PERFORM.

    PERFORM 2000-WRITE-SUMMARY.

    CLOSE TXN-FILE
          REPORT-FILE.
    STOP RUN.

1000-PROCESS-BATCH-TXN.
    ADD 1 TO WS-RECORD-COUNT.
    ADD TXN-AMOUNT TO WS-TOTAL-POSTED.

    EXEC SQL
        UPDATE ACCOUNT_MASTER
        SET BALANCE = BALANCE + :TXN-AMOUNT
        WHERE ACCOUNT_ID = :TXN-ACCOUNT-ID
    END-EXEC.

2000-WRITE-SUMMARY.
    MOVE WS-RECORD-COUNT TO RPT-RECORD(1:9).
    WRITE RPT-RECORD.
