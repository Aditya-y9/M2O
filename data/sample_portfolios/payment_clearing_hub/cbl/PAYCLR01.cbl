IDENTIFICATION DIVISION.
PROGRAM-ID. PAYCLR01.
ENVIRONMENT DIVISION.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY PAYREC.
01 WS-RESP                    PIC S9(8) COMP.
01 WS-SYNC-RESP               PIC S9(8) COMP.

EXEC SQL INCLUDE SQLCA END-EXEC.

PROCEDURE DIVISION.
0000-PROCESS-PAYMENT.
    EXEC CICS RECEIVE INTO(PAYMENT-RECORD)
              RESP(WS-RESP)
    END-EXEC.

    IF WS-RESP = DFHRESP(NORMAL)
        PERFORM 1000-VALIDATE-ISO-MSG
        PERFORM 2000-WRITE-SETTLEMENT-DB
        PERFORM 3000-COMMIT-TWO-PHASE
        PERFORM 4000-EMIT-ACK
    ELSE
        PERFORM 9000-ROLLBACK-TXN
    END-IF.

    EXEC CICS RETURN END-EXEC.

1000-VALIDATE-ISO-MSG.
    IF PAY-AMOUNT <= 0
        PERFORM 9000-ROLLBACK-TXN
    END-IF.

2000-WRITE-SETTLEMENT-DB.
    EXEC SQL
        INSERT INTO SETTLEMENT_LEDGER
        (PAYMENT_REF, DEBIT_ACC, CREDIT_ACC, AMOUNT, STATUS)
        VALUES (:PAY-REF, :PAY-DEBIT-ACC, :PAY-CREDIT-ACC, :PAY-AMOUNT, 'PND')
    END-EXEC.

3000-COMMIT-TWO-PHASE.
    * Explicit Two-Phase Commit across heterogeneous participants
    EXEC CICS SYNCPOINT RESP(WS-SYNC-RESP) END-EXEC.
    IF WS-SYNC-RESP NOT = DFHRESP(NORMAL)
        PERFORM 9000-ROLLBACK-TXN
    END-IF.

4000-EMIT-ACK.
    EXEC CICS SEND FROM(PAYMENT-RECORD) END-EXEC.

9000-ROLLBACK-TXN.
    EXEC CICS SYNCPOINT ROLLBACK END-EXEC.
